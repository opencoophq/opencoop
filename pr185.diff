+  let audienceQueue: any;
+
+  beforeEach(async () => {
+    prisma = {
+      shareholder: {
+        findUnique: jest.fn(),
+        update: jest.fn().mockResolvedValue({}),
+      },
+      $executeRaw: jest.fn(),
