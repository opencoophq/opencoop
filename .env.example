# Database
DATABASE_URL=postgresql://opencoop:opencoop@localhost:5432/opencoop

# Redis
REDIS_URL=redis://localhost:6379

# Auth (custom JWT, not NextAuth)
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# API
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3002

# SMTP (optional - per-coop SMTP settings override these)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@opencoop.be

# Field encryption (for nationalId)
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ESSENTIALS_MONTHLY_PRICE_ID=
STRIPE_ESSENTIALS_YEARLY_PRICE_ID=
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=
STRIPE_PROFESSIONAL_YEARLY_PRICE_ID=

# File Storage
UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------------
# Optional integrations
# Everything below is optional for local dev. Leave blank to disable the
# related feature. Each var maps to a real process.env / configService usage.
# ---------------------------------------------------------------------------

# Google OAuth sign-in (apps/api auth strategies)
GOOGLE_CLIENT_ID=                  # OAuth client ID from Google Cloud console
GOOGLE_CLIENT_SECRET=              # OAuth client secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback  # OAuth redirect URI

# Apple Sign In (apps/api auth strategies)
APPLE_CLIENT_ID=                   # Services ID (e.g. com.opencoop.signin)
APPLE_TEAM_ID=                     # Apple developer Team ID
APPLE_KEY_ID=                      # Key ID for the Sign In with Apple private key
APPLE_KEY_PATH=                    # Path to the .p8 private key file
APPLE_CALLBACK_URL=http://localhost:3001/auth/apple/callback    # OAuth redirect URI

# Passkeys / WebAuthn (apps/api auth)
WEBAUTHN_RP_NAME=OpenCoop          # Relying party display name
WEBAUTHN_RP_ID=localhost           # Relying party ID (domain, no scheme/port)
WEBAUTHN_ORIGIN=http://localhost:3002  # Expected origin of WebAuthn requests

# Ponto (Isabel) bank-sync integration (apps/api ponto module)
PONTO_CLIENT_ID=                   # Ponto OAuth client ID
PONTO_CLIENT_SECRET=               # Ponto OAuth client secret
PONTO_REDIRECT_URI=                # OAuth redirect URI registered with Ponto
PONTO_CERT_PATH=                   # Path to the mTLS client certificate
PONTO_KEY_PATH=                    # Path to the mTLS private key
PONTO_KEY_PASSPHRASE=              # Passphrase for the mTLS private key
PONTO_WEBHOOK_SIGNING_KEY=         # Key used to verify Ponto webhook signatures
PONTO_SANDBOX=true                 # Use the Ponto sandbox environment

# Sentry error tracking (no-op if unset)
SENTRY_DSN=                        # Server-side DSN (API + Next.js server/edge), runtime env
NEXT_PUBLIC_SENTRY_DSN=            # Client-side DSN for the Next.js web app — inlined at BUILD time

# GitHub feedback-to-issue pipeline (apps/api feature-requests module)
GITHUB_TOKEN=                      # PAT used to open issues from in-app feedback

# Email / meeting formatting (apps/api email processor)
MEETING_TIME_ZONE=Europe/Brussels  # IANA tz used to format meeting times in emails

# NextAuth-named vars (passed to the web container in deploy; web stores JWT in
# localStorage and does not use next-auth, but these are read in deploy config)
NEXTAUTH_URL=http://localhost:3002  # Web app base URL
NEXTAUTH_SECRET=                    # Set in prod (deploy uses JWT_SECRET here)
