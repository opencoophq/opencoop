# Environment name (acc or prod) - used for container naming
ENV_NAME=acc

# Docker image tag (git SHA)
TAG=latest

# Docs image tag (independent from main TAG)
DOCS_TAG=latest

# GHCR owner (GitHub org or user)
GHCR_OWNER=opencoophq

# ---------- Database ----------
# Generate a URL-safe password (no special characters):
#   openssl rand -hex 32
# Do NOT use base64 — it produces /, +, = which break DATABASE_URL.
POSTGRES_PASSWORD=

# Full connection string. Uses POSTGRES_PASSWORD from above.
# If you must use special characters, percent-encode them
# (e.g. / → %2F, = → %3D, + → %2B).
DATABASE_URL=postgresql://opencoop:${POSTGRES_PASSWORD}@postgres:5432/opencoop

# ---------- Auth ----------
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Frontend URL (used for CORS, email links, etc.)
FRONTEND_URL=https://acc.opencoop.be

# ---------- Feature Flags ----------
# Set to "waitlist" to show email collection dialog instead of onboarding links
LAUNCH_MODE=waitlist

# ---------- Field Encryption ----------
# AES-256-GCM key for encrypting nationalId fields
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=

# ---------- SMTP (Brevo) ----------
# Get credentials at: https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenCoop <noreply@opencoop.be>

# ---------- Google OAuth ----------
# Get credentials at: https://console.cloud.google.com/apis/credentials
# 1Password: "Google OAuth - OpenCoop" in Armlab vault
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://acc.opencoop.be/api/auth/google/callback

# ---------- Apple Sign In ----------
# Get credentials at: https://developer.apple.com/account
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_KEY_PATH=
APPLE_CALLBACK_URL=https://acc.opencoop.be/api/auth/apple/callback

# ---------- Stripe Billing ----------
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create prices at: https://dashboard.stripe.com/products
STRIPE_ESSENTIALS_MONTHLY_PRICE_ID=
STRIPE_ESSENTIALS_YEARLY_PRICE_ID=
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=
STRIPE_PROFESSIONAL_YEARLY_PRICE_ID=

# ---------- Passkeys / WebAuthn ----------
WEBAUTHN_RP_NAME=OpenCoop
WEBAUTHN_RP_ID=acc.opencoop.be                       # domain only, no scheme/port
WEBAUTHN_ORIGIN=https://acc.opencoop.be              # expected request origin

# ---------- Ponto (Isabel) bank sync ----------
# mTLS cert/key files must be mounted into the API container
PONTO_CLIENT_ID=
PONTO_CLIENT_SECRET=
PONTO_REDIRECT_URI=https://acc.opencoop.be/api/ponto/callback
PONTO_CERT_PATH=
PONTO_KEY_PATH=
PONTO_KEY_PASSPHRASE=
PONTO_WEBHOOK_SIGNING_KEY=
PONTO_SANDBOX=true

# ---------- Sentry (API error tracking) ----------
# No-op if unset
SENTRY_DSN=

# ---------- GitHub feedback-to-issue pipeline ----------
# PAT used by the feature-requests module to open issues from in-app feedback
GITHUB_TOKEN=

# ---------- Email / meeting formatting ----------
# IANA tz used to format meeting times in emails
MEETING_TIME_ZONE=Europe/Brussels

# Note: NEXTAUTH_URL / NEXTAUTH_SECRET are passed to the web container by
# docker-compose.yml (derived from FRONTEND_URL / JWT_SECRET) — no separate
# values needed here.
