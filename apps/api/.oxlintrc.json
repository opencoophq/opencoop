{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true,
    "jest": true
  },
  "ignorePatterns": ["dist/**", "coverage/**"],
  "rules": {
    "typescript/no-explicit-any": "off",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  }
}
