exports[`EmailProcessor render snapshots (byte-exact baseline) template "meeting-convocation" renders in de 1`] = `
"
      <!DOCTYPE html>
      <html>
      <head>
        <meta charset="utf-8">
        <style>
          body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
          h1 { color: #1e40af; }
        </style>
      </head>
      <body>
        
          
          <div style="border-bottom: 3px solid #0E7C66; padding-bottom: 14px; margin-bottom: 22px;">
            <div style="text-align: center; margin-bottom: 24px;">
               <img src="https://opencoop.test/logo.png" alt="Coöp &amp; Co" style="max-height: 80px; max-width: 240px;" />
             </div>
            <h1 style="margin: 0; color: #0E7C66; font-size: 22px;">Einladung — Coöp &amp; Co</h1>
            <p style="margin: 4px 0 0; color: #555; font-size: 14px;">Generalversammlung</p>
          </div>
          <p>Liebe/r Jan Peeters,</p>
          <p>Im Namen von <strong>Coöp &amp; Co</strong> laden wir Sie zur <strong>Algemene Vergadering 2026</strong> am <strong>Samstag, 9. Mai 2026 um 10:00</strong> in <strong>Theresiastraat 29, 3500 Hasselt</strong> ein.</p>
          <h2 style="color: #0E7C66;">Tagesordnung</h2>
          <ol><li><strong>Eerste punt</strong><br><span style="color:#555;">Beschrijving een</span></li><li><strong>Tweede punt</strong><br><span style="color:#555;">Beschrijving twee</span></li></ol>
          
          <p style="text-align: center; margin: 30px 0;">
            <a href="https://opencoop.test/meetings/rsvp/token?a=1&b=2"
               style="background-color: #0E7C66; color: white; padding: 12px 24px;
                      text-decoration: none; border-radius: 6px; display: inline-block;
                      font-weight: 600;">
              Auf die Einladung antworten
            </a>
          </p>
          <p>Klicken Sie oben auf die Schaltfläche, um anzugeben, ob Sie teilnehmen werden, nicht teilnehmen werden, oder Ihre Stimme an einen anderen Anteilseigner zu delegieren (Vollmacht).</p>
          <p style="color: #666; font-size: 12px;">Die offizielle Einladung ist als PDF beigefügt.</p>
          <p>Mit freundlichen Grüßen,<br><strong>Der Vorstand von Coöp &amp; Co</strong></p>
        
        <hr>
        <p style="color: #666; font-size: 12px;">
          This email was sent by Coöp &amp; Co via OpenCoop.
        </p>
      </body>
      </html>
    "
`;

