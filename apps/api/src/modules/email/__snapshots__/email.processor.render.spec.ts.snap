exports[`EmailProcessor render snapshots (byte-exact baseline) additional branch cases meeting-convocation (custom body) in de 1`] = `
"
      <!DOCTYPE html>
      <html>
      <head>
        <meta charset="utf-8">
        <style>
          body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
          h1 { color: #1e40af; }
        </style>
      </head>
      <body>
        
          <div style="border-bottom: 3px solid #1e40af; padding-bottom: 14px; margin-bottom: 22px;">
            
            <h1 style="margin: 0; color: #1e40af; font-size: 22px;">Einladung — Coöp &amp; Co</h1>
            <p style="margin: 4px 0 0; color: #555; font-size: 14px;">Generalversammlung</p>
          </div><p>Beste Jan Peeters, kom naar Algemene Vergadering 2026 op Samstag, 9. Mai 2026 um 10:00 te Theresiastraat 29, 3500 Hasselt.</p><ol><li><strong>Eerste punt</strong><br><span style="color:#555;">Beschrijving een</span></li></ol><p>Groeten van Coöp &amp; Co.</p>
          <p style="text-align: center; margin: 30px 0;">
            <a href="https://opencoop.test/meetings/rsvp/token"
               style="background-color: #1e40af; color: white; padding: 12px 24px;
                      text-decoration: none; border-radius: 6px; display: inline-block;
                      font-weight: 600;">
              Auf die Einladung antworten
            </a>
          </p>
        <hr>
        <p style="color: #666; font-size: 12px;">
          This email was sent by Coöp &amp; Co via OpenCoop.
        </p>
      </body>
      </html>
    "
`;

