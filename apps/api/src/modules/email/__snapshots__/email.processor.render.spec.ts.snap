exports[`EmailProcessor render snapshots (byte-exact baseline) template "share-purchase" renders in de 1`] = `
"
      <!DOCTYPE html>
      <html>
      <head>
        <meta charset="utf-8">
        <style>
          body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
          h1 { color: #1e40af; }
        </style>
      </head>
      <body>
        
    <h1>Ihre Bestellung ist bestätigt</h1>
    <p>Liebe/r Jan Peeters,</p>
    <p>Vielen Dank für Ihre Bestellung bei Coöp &amp; Co. Wir haben sie erhalten — auf unserer Website müssen Sie nichts weiter tun. Mit den untenstehenden Daten überweisen Sie den Betrag über Ihre Banking-App.</p>

    <h2>Ihre Bestellung</h2>
    <ul>
      <li>Anteilsklasse: Aandeel A</li>
      <li>Anzahl: 3</li>
      <li>Gesamtbetrag: €75.00</li>
    </ul>

    
    <h2>Zahlungsdetails</h2>
    <p>Empfänger: <strong>Coöp &amp; Co</strong></p>
    <p>IBAN: <strong>BE68 5390 0754 7034</strong></p>
    <p>Betrag: <strong>€75.00</strong></p>
    <p>Strukturierte Mitteilung: <strong>+++123/4567/89012+++</strong></p>
    

    <h2>Wie geht es weiter?</h2>
    <ol>
      <li>Ihre Bestellung ist erfasst</li>
      <li>Überweisen Sie den Betrag über Ihre Banking-App mit den obigen Angaben</li>
      <li>Sobald wir Ihre Zahlung zugeordnet haben (in der Regel innerhalb von 1–2 Werktagen), erhalten Sie eine zweite E-Mail. Erst dann sind Ihre Anteile aktiv.</li>
    </ol>
    <p><em>Kein Stress — Sie können auch später zahlen, wann es Ihnen passt.</em></p>

    <p>Vielen Dank für Ihre Investition in Coöp &amp; Co!</p>
  
        <hr>
        <p style="color: #666; font-size: 12px;">
          This email was sent by Coöp &amp; Co via OpenCoop.
        </p>
      </body>
      </html>
    "
`;

